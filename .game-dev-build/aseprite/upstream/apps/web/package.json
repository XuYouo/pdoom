{
	"name": "@pebbly/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:fsd": "steiger --reporter=json --fail-on-warnings ./src",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"generate:icons": "node scripts/generate-icons.mjs"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@iconify-json/pixelarticons": "^1.2.9",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.52.0",
		"@realfavicongenerator/generate-favicon": "^0.9.0",
		"@realfavicongenerator/image-adapter-node": "^0.9.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"sharp": "^0.34.5",
		"steiger": "^0.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.3"
	},
	"dependencies": {
		"@fontsource-variable/pixelify-sans": "^5.3.0",
		"@pebbly/gallery": "workspace:*",
		"@vercel/analytics": "^2.0.1",
		"clsx": "^2.1.1",
		"marked": "^18.1.0",
		"tailwind-merge": "^3.7.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#app-shell/*": "./src/app/*",
		"#pages/*": "./src/pages/*",
		"#widgets/*": "./src/widgets/*",
		"#features/*": "./src/features/*",
		"#entities/*": "./src/entities/*",
		"#shared/*": "./src/shared/*"
	}
}
