{
  "name": "pdoom-game",
  "description": "P(Doom): 100% — a pixel action roguelite with React, Phaser and Scala.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "keywords": [
    "phaser",
    "phaser4",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "npm run typecheck && vite build --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "npm run build"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "1.56",
    "@tailwindcss/vite": "4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "4.1",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^4.1.12"
  }
}
